{
  "name": "PDF Accessibility Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "postCreateCommand": "bash deploy/install_tools.sh && pip install -e '.[dev]'",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "PDF Accessibility Studio", "onAutoForward": "notify", "visibility": "private" }
  },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
